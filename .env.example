# App (nginx → 외부 포트)
APP_PORT=8088

# Postgres (로컬 개발용 기본값 / compose가 컨테이너용으로 덮어씀)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mydb

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
JWT_SECRET_KEY=your_jwt_secret_key_run_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=1

# OpenAI
OPENAI_API_KEY=sk-...your_openai_api_key...
OPENAI_MODEL=gpt-4o-mini
